# Optional KulOffice provider configuration. The Compose-managed database,
# identity, files, ledger, Gateway and QR settings are defined in compose.yaml.

# MiniAiLive. Disable BIOMETRICS_ENABLED in .env for manual-only review.
KULOFFICE_MINIAILIVE_FACE_LIVESS_URL=
KULOFFICE_MINIAILIVE_FACE_MATCH_URL=
KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_URL=
KULOFFICE_MINIAILIVE_DOCUMENT_EXTRACTION_URL=
KULOFFICE_MINIAILIVE_FACE_LIVENESS_MODE=enforce
KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_MODE=shadow
KULOFFICE_MINIAILIVE_FALLBACK_TO_MANUAL=true
KULOFFICE_MINIAILIVE_REQUEST_TIMEOUT=20s
KULOFFICE_MINIAILIVE_RETRIES=1

# Identity-document/NUIB integrations, when contracted by the bank.
KULOFFICE_IDFORT_STANDARD_SCAN_URL=
KULOFFICE_IDFORT_QUICK_SCAN_URL=
KULOFFICE_IDFORT_SELFIE_LIVENESS_URL=
KULOFFICE_IDFORT_DOWNLOAD_IMAGE_URL=
KULOFFICE_IDFORT_API_KEY=
KULOFFICE_NUIBAPI_REQ_SINGULAR_URL=
KULOFFICE_NUIBAPI_REQ_COLECTIVO_URL=
KULOFFICE_NUIBAPI_RESPONSE_URL=
KULOFFICE_NUIBAPI_API_KEY=

# Localized transactional message templates.
KULOFFICE_ENGINE_MESSAGE_TRANSFER=
KULOFFICE_ENGINE_MESSAGE_DEPOSIT=
KULOFFICE_ENGINE_MESSAGE_RECEIVE=
KULOFFICE_ENGINE_MESSAGE_CHECKBALANCE=
KULOFFICE_ENGINE_MESSAGE_DEPOSITAGENT=
KULOFFICE_ENGINE_MESSAGE_WITHDRAWAL=
KULOFFICE_ENGINE_MESSAGE_TRANSACTIONFAILED=
