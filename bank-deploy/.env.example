# KulPay bank deployment. Copy with `make setup`, replace every CHANGE_ME,
# then keep .env readable only by the deployment account (mode 0600).

# ── immutable container images ───────────────────────────────────────────────
# Use release tags approved by the bank and record the resolved immutable
# digests in the release manifest. Mirror the repositories for an offline bank.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.2.4-alpine
TYPESENSE_IMAGE=typesense/typesense:29.0
ALPINE_IMAGE=alpine:3.20
KEYCLOAK_IMAGE=developerspavs/kulpay-keycloak
KEYCLOAK_TAG=CHANGE_ME
KULOFFICE_IMAGE=developerspavs/kulpay-kuloffice
KULOFFICE_TAG=CHANGE_ME
WEB_IMAGE=developerspavs/kulpay-web
WEB_TAG=CHANGE_ME
FILESERVER_IMAGE=developerspavs/kulpay-fileserver
FILESERVER_TAG=CHANGE_ME
PROVISIONER_IMAGE=developerspavs/kulpay-tools
PROVISIONER_TAG=CHANGE_ME
SOLANGE_IMAGE=developerspavs/kulpay-solange
SOLANGE_TAG=CHANGE_ME
SOLANGE_CONSOLE_IMAGE=developerspavs/kulpay-solange-console
SOLANGE_CONSOLE_TAG=CHANGE_ME
KULPORTAL_IMAGE=developerspavs/kulpay-kulportal
KULPORTAL_TAG=CHANGE_ME
GATEWAY_IMAGE=developerspavs/kulpay-gateway
GATEWAY_TAG=CHANGE_ME
BLNK_IMAGE=jerryenebeli/blnk
BLNK_TAG=0.15.6
MINIO_IMAGE=developerspavs/kulpay-minio
MINIO_TAG=CHANGE_ME
MC_IMAGE=developerspavs/kulpay-mc
MC_TAG=CHANGE_ME

# ── public addresses and loopback ports ──────────────────────────────────────
# The bank's load balancer or reverse proxy terminates TLS and forwards to
# these host ports. Containers never bind directly to a public interface.
PUBLISH_ADDRESS=127.0.0.1
# Set true only when a remote bank load balancer must reach a dedicated private
# host address placed in PUBLISH_ADDRESS and the firewall restricts its source.
ALLOW_REMOTE_PROXY=false
KEYCLOAK_PUBLIC_URL=https://auth.kulpay.bank.example
KEYCLOAK_PUBLIC_HOST=auth.kulpay.bank.example
KULOFFICE_PUBLIC_URL=https://core.kulpay.bank.example
KULOFFICE_PUBLIC_HOST=core.kulpay.bank.example
WEB_PUBLIC_URL=https://app.kulpay.bank.example
GATEWAY_PUBLIC_URL=https://payments.kulpay.bank.example
GATEWAY_MGMT_PUBLIC_URL=https://payments.kulpay.bank.example
SOLANGE_PUBLIC_URL=https://qr.kulpay.bank.example
SOLANGE_CONSOLE_PUBLIC_URL=https://qr-console.kulpay.bank.example
KULPORTAL_PUBLIC_URL=https://portal.kulpay.bank.example
KEYCLOAK_PORT=9180
KULOFFICE_PORT=9280
WEB_PORT=9380
GATEWAY_PORT=9480
GATEWAY_MGMT_PORT=9481
SOLANGE_PORT=9580
SOLANGE_CONSOLE_PORT=9680
KULPORTAL_PORT=9780
STACK_SUBNET=10.251.0.0/24
STACK_GATEWAY=10.251.0.1
# Host bridge gateway for a local proxy, or the reachable private address of a
# remote TLS load balancer. Used for issuer discovery and signed webhooks.
TLS_PROXY_ADDRESS=10.251.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The bundled PostgreSQL creates one database and role per application.
DB_ROOT_PASSWORD=CHANGE_ME
KULOFFICE_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
SOLANGE_DB_PASSWORD=CHANGE_ME
BLNK_DB_PASSWORD=CHANGE_ME
GATEWAY_DB_PASSWORD=CHANGE_ME

# ── Intaka / Keycloak ────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME
REALM=kulpay
WORKFORCE_REALM=workforce
ADMIN_CLIENT_ID=kulpay-backend
ADMIN_CLIENT_SECRET=CHANGE_ME
WORKFORCE_API_SECRET=CHANGE_ME
GATEWAY_KULOFFICE_CLIENT_ID=kulpay-gateway
GATEWAY_KULOFFICE_CLIENT_SECRET=CHANGE_ME
GATEWAY_OIDC_CLIENT_ID=kulpay-gateway-admin
GATEWAY_OIDC_CLIENT_SECRET=CHANGE_ME
WEB_CLIENT_ID=kulpay-web
PASSKEY_CLIENT_ID=kulpay-web-passkey
MOBILE_CLIENT_ID=kulpay-mobile
MOBILE_REDIRECT_URI=mz.co.kulpay://oauthredirect
KULPORTAL_CLIENT_SECRET=CHANGE_ME
KULPORTAL_SESSION_SECRET=CHANGE_ME
SOLANGE_CONSOLE_CLIENT_ID=solange-console
PHONE_BUDGET=3
IP_BUDGET=10
LOOKUP_BUDGET=30
PASSKEY_APP_ORIGINS=

# Real SMS provider. No development inbox exists in this deployment.
OLA_SMS_BASE_URL=https://sms.bank.example/v1/messages
OLA_SMS_API_KEY=CHANGE_ME
OLA_SMS_PROVIDER_ID=CHANGE_ME

# ── licensed KulOffice core ──────────────────────────────────────────────────
KULOFFICE_ENVIRONMENT=production
KULOFFICE_ADMIN_EMAIL=kuloffice-admin@bank.example
KULOFFICE_ADMIN_PASSWORD=CHANGE_ME
KULOFFICE_ADMIN_BASIC_ENABLED=true
KULOFFICE_LICENSE_KEY=CHANGE_ME
BIOMETRICS_ENABLED=true
KULOFFICE_EMBEDDED_FINANCIAL_WORKER='{"enabled":true,"capabilities":["product_balance:query","product_transfer:create","fee:collect","transaction_fee:collect","bill_payment:create","checkout_balance:reserve","checkout_balance:capture","checkout_balance:void","checkout_balance:refund"],"max_capacity":2}'

# ── BLNK ledger ───────────────────────────────────────────────────────────────
BLNK_SERVER_SECRET_KEY=CHANGE_ME
BLNK_TOKENIZATION_SECRET=CHANGE_ME
BLNK_TYPESENSE_API_KEY=CHANGE_ME

# ── licensed payments Gateway ─────────────────────────────────────────────────
# The image contains the licensed core. License delivery/activation is agreed
# with Pavulla and recorded in the installation acceptance report.
GATEWAY_ACCOUNT_ID=CHANGE_ME_27_ALPHANUMERIC
GATEWAY_API_KEY=CHANGE_ME
GATEWAY_SERVICE_API_KEY=CHANGE_ME
GATEWAY_ADMIN_KEY=CHANGE_ME
GATEWAY_CHECKER_KEY=CHANGE_ME
GATEWAY_ENCRYPTION_KEY=CHANGE_ME
KULPAY_TRUSTED_PROXIES=127.0.0.0/8,::1/128,10.251.0.1

# Financial features start disabled. Enable one at a time after connector and
# webhook acceptance tests. Supply additionally needs a real BLNK balance.
KULOFFICE_TOPUP_ENABLED=false
KULOFFICE_INCOMING_TRANSFERS_ENABLED=false
KULOFFICE_INCOMING_TRANSFERS_WEBHOOK_SECRETS=
KULOFFICE_SUPPLY_ENABLED=false
KULOFFICE_SUPPLY_CLEARING_BALANCE=
KULOFFICE_PAYMENT_ACCEPTANCE_ENABLED=false
KULOFFICE_PAYMENT_ACCEPTANCE_PROVISIONING_ENABLED=false
KULOFFICE_PAYMENT_ACCEPTANCE_SECRET_SEAL_KEY=
KULOFFICE_PAYMENT_ACCEPTANCE_WEBHOOK_SECRETS=
KULOFFICE_RECONCILIATION_ENABLED=false
KULOFFICE_CHECKOUT_PROVIDER_WAKEUP_SIGNING_SECRETS=
KULOFFICE_CHECKOUT_PROVIDER_WAKEUP_TEST_SIGNING_SECRETS=

# ── MinIO and Boquisso ───────────────────────────────────────────────────────
MINIO_ROOT_USER=kulpay
MINIO_ROOT_PASSWORD=CHANGE_ME
BOQUISSO_ACCESS_KEY=boquisso
BOQUISSO_SECRET_KEY=CHANGE_ME
KYC_BUCKET=kyc
PENDING_BUCKET=kyc-pending
LOGO_BUCKET=logos
PENDING_EXPIRY_DAYS=1

# ── Solange QR ────────────────────────────────────────────────────────────────
SOLANGE_VISITOR_SECRET=CHANGE_ME
SOLANGE_ENCRYPTION_KEY=CHANGE_ME
SOLANGE_SESSION_SECRET=CHANGE_ME
SOLANGE_KULPAY_MODE=live
SOLANGE_SUPPORT=
KULOFFICE_SOLANGE_API_KEY=
KULOFFICE_SOLANGE_WEBHOOK_SECRETS=
PERSONAL_PAYMENT_REQUESTS=false

# ── web application ──────────────────────────────────────────────────────────
KULPAY_SESSION_SECRET=CHANGE_ME
