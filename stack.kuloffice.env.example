# Extra kuloffice settings for the local stack. Copy to stack.kuloffice.env
# (gitignored), edit, then `make kuloffice` to recreate kuloffice with them.
# Settings the compose file sets itself (ports, database, Keycloak, SMS, file
# server) are not taken from here.

# MiniAiLive. The defaults are the hosted instance; set your own here.
# (The "LIVESS" spelling is kuloffice's key name.)
# "LIVESS" is how kuloffice spells this key (face_livess_url); FACE_LIVENESS_URL is ignored.
# KULOFFICE_MINIAILIVE_FACE_LIVESS_URL=http://host:8011/api/check_liveness
# KULOFFICE_MINIAILIVE_FACE_MATCH_URL=http://host:8010/api/face_match
# KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_URL=http://host:8021/api/check_id_liveness
# KULOFFICE_MINIAILIVE_DOCUMENT_EXTRACTION_URL=http://host:8020/api/check_id

# Decisions (defaults shown).
# KULOFFICE_MINIAILIVE_FACE_LIVENESS_MODE=enforce        # off | shadow | enforce
# KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_MODE=shadow     # off | shadow | enforce
# KULOFFICE_MINIAILIVE_FACE_MATCH_THRESHOLD=
# KULOFFICE_MINIAILIVE_FACE_LIVENESS_THRESHOLD=
# KULOFFICE_MINIAILIVE_FALLBACK_TO_MANUAL=true           # MiniAiLive down -> reviewer
# KULOFFICE_MINIAILIVE_REQUEST_TIMEOUT=20s
# KULOFFICE_MINIAILIVE_RETRIES=1
