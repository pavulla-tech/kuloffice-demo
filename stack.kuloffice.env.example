# Extra kuloffice settings for the local stack. Copy to stack.kuloffice.env
# (gitignored), edit, then `make kuloffice` to recreate kuloffice with them.
# Settings the compose file sets itself (ports, database, Keycloak, SMS, file
# server) are not taken from here.

# MiniAiLive. The defaults are the hosted instance; set your own here.
# (The "LIVESS" spelling is kuloffice's key name.)
# "LIVESS" is how kuloffice spells this key (face_livess_url); FACE_LIVENESS_URL is ignored.
# KULOFFICE_MINIAILIVE_FACE_LIVESS_URL=http://host:8011/api/check_liveness
# KULOFFICE_MINIAILIVE_FACE_MATCH_URL=http://host:8010/api/face_match
# KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_URL=http://host:8021/api/check_id_liveness
# KULOFFICE_MINIAILIVE_DOCUMENT_EXTRACTION_URL=http://host:8020/api/check_id

# Decisions (defaults shown).
# KULOFFICE_MINIAILIVE_FACE_LIVENESS_MODE=enforce        # off | shadow | enforce
# KULOFFICE_MINIAILIVE_DOCUMENT_LIVENESS_MODE=shadow     # off | shadow | enforce
# KULOFFICE_MINIAILIVE_FACE_MATCH_THRESHOLD=
# KULOFFICE_MINIAILIVE_FACE_LIVENESS_THRESHOLD=
# KULOFFICE_MINIAILIVE_FALLBACK_TO_MANUAL=true           # MiniAiLive down -> reviewer
# KULOFFICE_MINIAILIVE_REQUEST_TIMEOUT=20s
# KULOFFICE_MINIAILIVE_RETRIES=1

# Financial instruction execution inside the KulOffice process. Off by
# default. Start read-only; adding product_transfer:create or fee:collect can
# move balances on the configured BLNK.
# KULOFFICE_EMBEDDED_FINANCIAL_WORKER={"enabled":true,"capabilities":["product_balance:query"],"max_capacity":1}

# BLNK with the KulPay topology (after a reset: deploy/scripts/reset-blnk.sh
# for this kit's BLNK, reset-standalone-blnk.sh for another install). On start
# KulOffice finds or creates the customer-products and collections ledgers and
# the external-funds and product-fee balances by environment; no copied IDs.
# KULOFFICE_ADAPTER_BLNK_BASE_URL=http://<blnk-host>:5001
# KULOFFICE_ADAPTER_BLNK_API_KEY=
# KULOFFICE_ADAPTER_BLNK_ENVIRONMENT=local
# KULOFFICE_ADAPTER_BLNK_BOOTSTRAP_ENABLED=true

# Account top-up through the local development gateway (refused in
# production): payments settle at once through one connector binding, then
# post to that binding's collection balance and credit the product. The
# in-process top-up worker moves balances on the configured BLNK.
# KULOFFICE_TOPUP_ENABLED=true
# KULOFFICE_TOPUP_GATEWAY=local
# KULOFFICE_TOPUP_CONNECTOR_BINDING_ID=local-binding-1
# KULOFFICE_TOPUP_MAX_CAPACITY=2

# ---- also forwarded by the older kuloffice-only compose file ----------------
# idfort (KULOFFICE_KYC_PROVIDER=idfort, or as the fallback)
# KULOFFICE_IDFORT_STANDARD_SCAN_URL=
# KULOFFICE_IDFORT_QUICK_SCAN_URL=
# KULOFFICE_IDFORT_SELFIE_LIVENESS_URL=
# KULOFFICE_IDFORT_DOWNLOAD_IMAGE_URL=
# KULOFFICE_IDFORT_API_KEY=
# NUIB API
# KULOFFICE_NUIBAPI_REQ_SINGULAR_URL=
# KULOFFICE_NUIBAPI_REQ_COLECTIVO_URL=
# KULOFFICE_NUIBAPI_RESPONSE_URL=
# KULOFFICE_NUIBAPI_API_KEY=
# SMS templates
# KULOFFICE_ENGINE_MESSAGE_TRANSFER=
# KULOFFICE_ENGINE_MESSAGE_DEPOSIT=
# KULOFFICE_ENGINE_MESSAGE_RECEIVE=
# KULOFFICE_ENGINE_MESSAGE_CHECKBALANCE=
# KULOFFICE_ENGINE_MESSAGE_DEPOSITAGENT=
# KULOFFICE_ENGINE_MESSAGE_WITHDRAWAL=
# KULOFFICE_ENGINE_MESSAGE_TRANSACTIONFAILED=
