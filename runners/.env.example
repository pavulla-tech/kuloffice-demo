# Copy to .env (chmod 600). RUNNER_TOKEN: GitHub → pavulla-tech → Settings →
# Actions → Runners → New self-hosted runner, the token in the ./config.sh
# line. It expires one hour after it is made; only the first start needs it.
ORG_NAME=pavulla-tech
RUNNER_TOKEN=
# Pin once they run well (docker image ls shows the digests):
# RUNNER_IMAGE=myoung34/github-runner@sha256:…
# DIND_IMAGE=docker:27-dind@sha256:…
