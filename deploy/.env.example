# KulPay deployment settings. `make setup` copies this to .env; `make sync-env`
# brings an existing .env in line with it (values kept; new variables added
# commented out with these values, so uncomment one to set it; stale ones moved
# to the end). `make config` fails on anything required that is still empty.

# ── images (built by CI on a repository's tag; or make images && make push) ──
# One Docker Hub repository each. Tags are what the server pulls: v0.1.0-alpha01
# and so on, set by the deploy tool (bin/kulpay) when CI deploys a tag. Never
# reuse one, and leave them to the tool once a unit is deployed by CI.
KEYCLOAK_IMAGE=developerspavs/kulpay-keycloak
KEYCLOAK_TAG=
KULOFFICE_IMAGE=developerspavs/kulpay-kuloffice
KULOFFICE_TAG=
# BLNK is third-party but pinned: never deploy `latest` for the financial core.
BLNK_IMAGE=jerryenebeli/blnk
# 0.15.6 or later: kuloffice creates its named (@…) balances directly, which
# older versions (0.15.1, 0.10.x) silently ignore.
BLNK_TAG=0.15.6
WEB_IMAGE=developerspavs/kulpay-web
WEB_TAG=
FILESERVER_IMAGE=developerspavs/kulpay-fileserver
FILESERVER_TAG=
TOKEN_PANEL_IMAGE=developerspavs/kulpay-token-panel
TOKEN_PANEL_TAG=
TOOLS_IMAGE=developerspavs/kulpay-tools
TOOLS_TAG=
SOLANGE_IMAGE=developerspavs/kulpay-solange
SOLANGE_TAG=
SOLANGE_CONSOLE_IMAGE=developerspavs/kulpay-solange-console
SOLANGE_CONSOLE_TAG=
# MinIO and its client. MinIO stopped publishing images (Docker Hub, quay.io),
# so these are copies of the official minio/minio and minio/mc pushed to our
# namespace; `make images` does not build them.
MINIO_IMAGE=developerspavs/kulpay-minio
MINIO_TAG=
MC_IMAGE=developerspavs/kulpay-mc
MC_TAG=
KULPORTAL_IMAGE=developerspavs/kulpay-kulportal
# Empty until kulportal is ready; `make start-portal` refuses without it.
KULPORTAL_TAG=
# The website (kulpay-website); `make start-website` refuses without a tag.
WEBSITE_IMAGE=developerspavs/kulpay-website
WEBSITE_TAG=
# KulPay's own payments gateway (katembe-payments) and, on development
# servers only, the PSP simulator its live bindings point at. Never on a
# registry (localhost/ cannot be pulled): `make bundle` on the laptop, copy the
# archive to the server (scp), `make load FILE=…` there.
GATEWAY_IMAGE=localhost/kulpay-gateway
GATEWAY_TAG=
SIMULATOR_IMAGE=localhost/kulpay-psp-simulator
SIMULATOR_TAG=
# The Gateway's live bindings the simulator takes over on every deploy
# (gateway-bind). Empty: mpesa emola card. For a live test with real
# M-Pesa and e-Mola, set card and configure those two in the Gateway's
# Connectors page.
SIMULATOR_BIND_METHODS=
# The card rail the simulator plays: stripe (default) or simo, the mock SIMO
# acquirer for cards read at KulPay terminals (set GATEWAY_HSM_SOFT_BDK too).
SIMULATOR_BIND_CARD_DRIVER=

# Where `make images` builds from, on the laptop (sibling checkouts). The
# server never reads these.
INTAKA_DIR=../../keycloak-phone-authenticator
KULOFFICE_DIR=../../kuloffice
WEB_DIR=../../kulpay-web
FILESERVER_DIR=../../boquisso-fileserver
SOLANGE_DIR=../../../solange/solange
KULPORTAL_DIR=../../kulportal
WEBSITE_DIR=../../kulpay-website
GATEWAY_DIR=../../katembe-payments
SIMULATOR_DIR=../../kulpay-psp-simulator
# The server's architecture, not the laptop's.
TARGET_PLATFORM=linux/amd64

# ── public hostnames (Apache vhosts proxy them to the ports below) ────────────
# The Keycloak URL is the token issuer and the passkey rpId: changing it later
# invalidates every token and passkey.
KEYCLOAK_PUBLIC_URL=https://auth.kulpay.pavulla.com
KULOFFICE_PUBLIC_URL=https://core.kulpay.pavulla.com
WEB_PUBLIC_URL=https://app.kulpay.pavulla.com
SOLANGE_PUBLIC_URL=https://qr.kulpay.pavulla.com
SOLANGE_CONSOLE_PUBLIC_URL=https://console.qr.kulpay.pavulla.com
PANEL_PUBLIC_URL=https://panel.kulpay.pavulla.com
KULPORTAL_PUBLIC_URL=https://portal.kulpay.pavulla.com
# Baked into the website image (links, social cards): rebuild after changing.
WEBSITE_PUBLIC_URL=https://site.kulpay.pavulla.com
# The PSP simulator's customer page (and the card authentication page a top-up
# redirects to). Apache puts a password in front of it (apache/simulator.conf).
SIMULATOR_PUBLIC_URL=https://sim.kulpay.pavulla.com
# The gateway's public site (port GATEWAY_PORT): hosted checkout, payment
# links, partner portal, docs. Its management API and operator dashboard are
# on GATEWAY_MGMT_PORT, served at https://mgnt.kulpay.pavulla.com.
GATEWAY_PUBLIC_URL=https://gateway.kulpay.pavulla.com
GATEWAY_MGMT_PUBLIC_URL=https://mgnt.kulpay.pavulla.com
# Staff sign-in to the operator dashboard (workforce realm), after
# `make gateway-signin`. The client secret is generated by bin/kulpay.
GATEWAY_OIDC_ENABLED=false
GATEWAY_OIDC_CLIENT_SECRET=
# Keys the dashboard's session cookie. Generated by bin/kulpay.
GATEWAY_SESSION_SECRET=

# ── host ports (127.0.0.1 only) ───────────────────────────────────────────────
# Different from the stacks this replaces (8180, 8280, 8380), so both can run
# while Apache is switched over.
KEYCLOAK_PORT=9180
KULOFFICE_PORT=9280
WEB_PORT=9380
PANEL_PORT=9480
SOLANGE_PORT=9580
SOLANGE_CONSOLE_PORT=9680
KULPORTAL_PORT=9780
WEBSITE_PORT=8080
SIMULATOR_PORT=9880
# The gateway's public root and its management API (operator dashboard).
GATEWAY_PORT=9980
GATEWAY_MGMT_PORT=9981
# The stack's network. Apache reaches the services through its gateway, which
# Solange trusts for forwarded headers. Change both if the subnet is taken.
STACK_SUBNET=10.250.0.0/24
STACK_GATEWAY=10.250.0.1
# The gateway believes X-Forwarded-For only from these (IG-83). Empty: loopback
# and STACK_GATEWAY.
KULPAY_TRUSTED_PROXIES=

# ── databases (one Postgres, a database and role per service) ─────────────────
# Set once, before the first start: the roles are created from these on an
# empty data volume and never updated afterwards.
DB_ROOT_PASSWORD=
KULOFFICE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SOLANGE_DB_PASSWORD=
BLNK_DB_PASSWORD=
GATEWAY_DB_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# The customer realm and its clients.
REALM=kulpay
WEB_CLIENT_ID=kulpay-web
PASSKEY_CLIENT_ID=kulpay-web-passkey
MOBILE_CLIENT_ID=kulpay-mobile
# kuloffice's service-account client (admin API) and the audience every
# customer token carries.
ADMIN_CLIENT_ID=kulpay-backend
ADMIN_CLIENT_SECRET=
ONBOARDING_ROLE=onboarding_pending
# The Gateway's service principal for KulOffice checkout/projection calls.
# Generate the secret independently: openssl rand -hex 32
GATEWAY_KULOFFICE_CLIENT_ID=kulpay-gateway
GATEWAY_KULOFFICE_CLIENT_SECRET=
# The app schemes the mobile client may redirect to, comma separated.
MOBILE_REDIRECT_URI=com.pavulla.phoneauthdemo://oauthredirect,mz.co.kulpay://oauthredirect
# The USSD gateway's client.
USSD_CLIENT_ID=ussd-gateway
USSD_CLIENT_SECRET=
# Staff sign in here: reviewers (kuloffice) and Solange's console.
WORKFORCE_REALM=workforce
WORKFORCE_API_SECRET=
SOLANGE_CONSOLE_CLIENT_ID=solange-console
# Sign-in limits per hour (the extension's own defaults).
PHONE_BUDGET=3
IP_BUDGET=10
LOOKUP_BUDGET=30
BRUTE_FORCE_PROTECTED=true
# Passkey origins the mobile apps present (make apk-key-hash in intaka's
# demo/deploy prints them). Empty: passkeys from the apps are refused.
PASSKEY_APP_ORIGINS=
KC_PHONEAUTH_LOG_LEVEL=info
# The mobile app's login theme folder Keycloak mounts (as kulpay-mobile). The
# deploy tool sets it to the copy it takes out of the image
# (./state/theme/kulpay-mobile); empty: ./theme/kulpay.
KEYCLOAK_THEME_DIR=
# Web apps on developers' laptops that may sign in through this Keycloak (the
# local stack's KEYCLOAK=server), space-separated. make init (or Server →
# provision) adds them to the web and passkey clients. Empty: none.
DEV_WEB_ORIGINS=http://localhost:3000

# ── SMS (OLA): Keycloak's codes and kuloffice's messages ──────────────────────
OLA_SMS_BASE_URL=https://api.ola.pavulla.com/v1/messages
# KulOffice has no SMS defaults (IG-84): empty, SMS is off.
OLA_SMS_API_KEY=
OLA_SMS_PROVIDER_ID=

# ── kuloffice ─────────────────────────────────────────────────────────────────
KULOFFICE_ENVIRONMENT=production
# The env-admin (HTTP Basic): the only credential before a realm is registered.
KULOFFICE_ADMIN_EMAIL=admin@pavulla.com
# At least 20 characters outside development (IG-84). Left empty, bin/kulpay
# generates one here on deploy and provision.
KULOFFICE_ADMIN_PASSWORD=
# Basic sign-in for that admin (IG-84). Bootstrap needs it; set false after
# provisioning and `make kuloffice` to turn it off.
KULOFFICE_ADMIN_BASIC_ENABLED=true
# The issuer of service tokens (Gateway client, workers). Empty: the kulpay
# realm, KEYCLOAK_PUBLIC_URL/realms/REALM.
KULOFFICE_AUTH_SERVICE_ISSUER=
# Gateway provisioning of Payment Acceptance applications (IG-67). Turn on
# once the Gateway serves the IG-76 scopes. The seal key is generated by
# bin/kulpay when empty (openssl rand -base64 32); changing it loses waiting
# one-time secrets.
KULOFFICE_PAYMENT_ACCEPTANCE_PROVISIONING_ENABLED=false
KULOFFICE_PAYMENT_ACCEPTANCE_SECRET_SEAL_KEY=
# Checkout wake-ups to the Gateway (IG-45), live and test: comma separated,
# current first, at least 16 characters. Generated by bin/kulpay when empty
# (openssl rand -hex 32). Put the same value in each kulpay_balance binding's
# signing_secret for that mode.
KULOFFICE_CHECKOUT_PROVIDER_WAKEUP_SIGNING_SECRETS=
KULOFFICE_CHECKOUT_PROVIDER_WAKEUP_TEST_SIGNING_SECRETS=
# The platform kulpay_balance binding's application id (make platform-wallet);
# empty: kulpay-platform.
KULOFFICE_CHECKOUT_PROVIDER_PLATFORM_APPLICATION_ID=
# Signed with the private key whose public half the image was built with:
# `make license` prints one (from KULOFFICE_DIR/keys).
KULOFFICE_LICENSE_KEY=
# false: no MiniAiLive calls; a reviewer reads every document.
BIOMETRICS_ENABLED=true

# ── BLNK financial core ───────────────────────────────────────────────────────
# Master API key shared only by BLNK and KulOffice. Generate independently:
# openssl rand -hex 32
BLNK_SERVER_SECRET_KEY=
# Exactly 32 bytes; used by BLNK to protect tokenized identity fields:
# openssl rand -base64 24
BLNK_TOKENIZATION_SECRET=
# Typesense is internal, but still receives an independent strong key:
# openssl rand -hex 32
BLNK_TYPESENSE_API_KEY=
# Everything else kuloffice reads (MiniAiLive, BLNK, NUIB API, idfort, SMS
# templates) goes in kuloffice.env: see kuloffice.env.example.

# ── payments gateway (internal only) ──────────────────────────────────────────
# The stable Gateway tenant for KulOffice. Set it before the fresh launch
# reset; changing it later creates a different tenant boundary. Use one
# 27-character alphanumeric value (for example, generate 32 hex bytes and
# keep the first 27 characters).
GATEWAY_ACCOUNT_ID=
# KulOffice's account-owned key (payments, transfers, bills, artifacts and its
# own webhook endpoint):
# openssl rand -hex 32
GATEWAY_API_KEY=
# KulOffice's platform service key (payment/payable read-back, fee instructions
# and merchant webhook provisioning). Independent: openssl rand -hex 32
GATEWAY_SERVICE_API_KEY=
# The operator key creates the platform event sink and configures bindings.
# It has admin:read/write and connectors:read/write: openssl rand -hex 32
GATEWAY_ADMIN_KEY=
# A second operator key with its own principal, for maker-checker approvals
# (the operator key prepares, this one approves). Generated by bin/kulpay when
# empty: openssl rand -hex 32
GATEWAY_CHECKER_KEY=
# The PSP simulator's key (development): reconciliation:write only, on
# KulPay's Gateway account, to upload the provider settlement files of its
# direct M-Pesa, e-Mola and SIMO bindings. The simulator gets it as
# SIMULATOR_GATEWAY_SETTLEMENT_KEY. Generated by bin/kulpay when empty:
# openssl rand -hex 32
GATEWAY_SETTLEMENT_KEY=
# Encrypts connector credentials at rest; changing it makes stored bindings
# unreadable (gateway-bind writes them again): openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=
# The gateway licence (v0.1.1-alpha14 on: no licence, the gateway does not
# start). Signed with the KulOffice private key, whose public half the image is
# built with: kulpay-payments license issue --private-key keys/private.pem
# --issued-to pavulla.com. Not the KulOffice licence: that one is refused.
GATEWAY_LICENSE_KEY=
# Cards read at KulPay terminals, dev only: the software HSM's test BDK (the
# ANSI X9.24 example key, 0123456789ABCDEFFEDCBA9876543210, which the
# terminals' test key comes from) and true to let it serve this live-mode
# gateway. Empty: terminal cards are refused.
GATEWAY_HSM_SOFT_BDK=
GATEWAY_HSM_ALLOW_LIVE=
# Signs the gateway's reports (Ed25519 seed). Live mode needs it:
# openssl rand -base64 32
GATEWAY_AUDIT_SIGNING_KEY=
# Outbound mail for PSP onboarding confirmations and partner-portal sign-in
# links. The Gateway supports SMTP with STARTTLS/PLAIN auth (normally port
# 587), not implicit-TLS port 465. Keep the password only in the server .env.
KULPAY_SMTP_ADDR=smtp.example.com:587
KULPAY_SMTP_FROM=no-reply@kulpay.pavulla.com
KULPAY_SMTP_USERNAME=
KULPAY_SMTP_PASSWORD=
# The provider settings the Gateway adds to the credentials a merchant types
# on its credentials page (driver -> live|test -> key -> value; only base_url,
# host, origin, timeout for mpesa; endpoint, language, timeout for emola;
# api_base, timeout for stripe). Point each method where KulPay's own binding
# points: the simulator while SIMULATOR_BIND_METHODS includes it, else the real
# provider (M-Pesa needs nothing; e-Mola needs its endpoint). Wrap the JSON in
# single quotes: Compose drops the double quotes of an unquoted value, and the
# Gateway then refuses to start. The simulator:
# '{"mpesa":{"live":{"base_url":"http://simulator:8085/mpesa","timeout":"90s"},"test":{"base_url":"http://simulator:8085/mpesa","timeout":"90s"}},"emola":{"live":{"endpoint":"http://simulator:8085/emola","language":"pt","timeout":"90s"},"test":{"endpoint":"http://simulator:8085/emola","language":"pt","timeout":"90s"}},"stripe":{"live":{"api_base":"http://simulator:8085/card","timeout":"30s"},"test":{"api_base":"http://simulator:8085/card","timeout":"30s"}}}'
GATEWAY_CONNECTOR_SETUP_DEFAULTS=
# The platform service key's scopes. Empty: the service API of the
# ig1-collection-evidence gateway (v0.1.1-alpha00, alpha02 on). Only
# v0.1.1-alpha01 (kul-aparatus-compatibility, no service API) needs:
# GATEWAY_SERVICE_SCOPES=payments:read, transactions:read
GATEWAY_SERVICE_SCOPES=
# Development-only PSP simulator. The callback secrets sign simulated provider
# notifications. The partner key and statement profile come from a gateway QA
# partner. For a real rehearsal, enrol the PSP at GATEWAY_PUBLIC_URL/onboarding,
# complete technical setup, reveal its sandbox key once, and put that key here;
# leave these empty when the partner-bank workbench is not needed.
SIMULATOR_CALLBACK_SECRET=simulator-callback-secret
SIMULATOR_STRIPE_WEBHOOK_SECRET=whsec_simulator_gateway
SIMULATOR_DEFAULT_PROVIDER_FLOAT_MINOR=500000000
SIMULATOR_GATEWAY_PARTNER_KEY=
SIMULATOR_GATEWAY_MODE=test
SIMULATOR_STATEMENT_PROFILE_ID=
# Cash deposits at other PSPs: the key and HMAC secret the gateway's kulpay_cms
# connector sends to KulOffice's reference lookup (both sides read these).
# Generated by bin/kulpay when empty: openssl rand -hex 32
KULPAY_CMS_LOOKUP_API_KEY=
KULPAY_CMS_LOOKUP_SIGNING_SECRET=
# Orientu's custody (causes that hold their money until the close) and tips are
# KulOffice's own ledger balances, created at start-up: nothing to set here.

# Approvals: on a development stack one operator may propose and decide a
# change (policies, templates, reviews). Leave false in production, where a
# second operator decides.
KULOFFICE_APPROVALS_SINGLE_OPERATOR=true

# Development stacks only: the developers' admin operator, seeded again after
# every kuloffice, keycloak and gateway deploy and on provision, holding
# every operator permission (new releases' too). Its password is set again
# each time. With them, the same runs also approve the products' default
# notification texts (tools/dev_texts.json) where none is in force, and turn
# claim sends on in kuloffice.env (KulOffice v0.1.8-alpha09 and later).
# Leave both empty in production. Never commit the password.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Integration features are enabled one at a time after their smoke test. The
# webhook secrets below are written by `make gateway-kuloffice`; never fill
# them with invented values. Supply additionally needs a real BLNK clearing
# balance before it can be enabled.
KULOFFICE_INCOMING_TRANSFERS_ENABLED=false
KULOFFICE_INCOMING_TRANSFERS_WEBHOOK_SECRETS=
# Businesses' bills as Gateway invoices (KulOffice the biller). Needs incoming
# transfers on and the KulOffice biller at the Gateway, which
# `make gateway-kuloffice` creates and activates when missing (code KULPAY on
# GATEWAY_ACCOUNT_ID; kuloffice docs/GATEWAY_BILLS.md). The offering, when
# set, lets KulPay customers pay a bill in the app.
KULOFFICE_GATEWAY_BILLS_ENABLED=false
# Optional, not secrets: the biller's code and remittance details. Empty
# means the dev defaults KULPAY, FNB, 0028000090002922 and daily. Used only
# when the biller is created; an existing biller is never changed.
GATEWAY_KULOFFICE_BILLER_CODE=
GATEWAY_KULOFFICE_REMIT_BANK=
GATEWAY_KULOFFICE_REMIT_ACCOUNT=
GATEWAY_KULOFFICE_REMIT_FREQUENCY=
KULOFFICE_GATEWAY_BILLS_OFFERING_ID=
KULOFFICE_SUPPLY_ENABLED=true
KULOFFICE_SUPPLY_CLEARING_BALANCE=
KULOFFICE_PAYMENT_ACCEPTANCE_ENABLED=false
KULOFFICE_PAYMENT_ACCEPTANCE_WEBHOOK_SECRETS=
KULOFFICE_RECONCILIATION_ENABLED=false

# ── files (MinIO behind KulPay's own boquisso file server; internal only) ─────
MINIO_ROOT_USER=kulpay
MINIO_ROOT_PASSWORD=
KYC_BUCKET=kyc
PENDING_BUCKET=kyc-pending
# How long a KYC image that was never accepted (replaced, abandoned) is kept.
PENDING_EXPIRY_DAYS=1

# ── QR codes (kuloffice through Solange) ──────────────────────────────────────
# Written by `make solange-kulpay`: kuloffice's Solange key and the webhook
# signing secret. Empty: kuloffice runs with QR codes off.
KULOFFICE_SOLANGE_API_KEY=
KULOFFICE_SOLANGE_WEBHOOK_SECRETS=
# The hostname in KULOFFICE_PUBLIC_URL, without https:// (Solange posts its
# webhooks there, through the host's Apache).
KULOFFICE_PUBLIC_HOST=core.kulpay.pavulla.com
# live for production; test keeps Solange's codes and stats apart.
SOLANGE_KULPAY_MODE=live
# Shown on Solange's pages when a code cannot be used.
SOLANGE_SUPPORT=
# Business logos, shown where their codes are looked up.
LOGO_BUCKET=logos
# Whether verified persons may create payment requests (businesses follow
# their plan's payment_requests).
PERSONAL_PAYMENT_REQUESTS=false

# ── web app ───────────────────────────────────────────────────────────────────
# Seals the session cookies: openssl rand -hex 32
KULPAY_SESSION_SECRET=

# ── Solange (QR codes) ────────────────────────────────────────────────────────
# Keys the daily visitor hash: openssl rand -hex 32
SOLANGE_VISITOR_SECRET=
# Seals webhook signing secrets: openssl rand -base64 32
SOLANGE_ENCRYPTION_KEY=
# Seals the console's session cookies: openssl rand -base64 32
SOLANGE_SESSION_SECRET=
# true when Cloudflare is in front of qr.kulpay.pavulla.com.
SOLANGE_BEHIND_CLOUDFLARE=false
# Where scans' cities come from when Cloudflare does not say: a GeoLite2 City
# database in geoip/ (seen in the container as /geoip). Set
# SOLANGE_GEOIP_DB=/geoip/GeoLite2-City.mmdb with MaxMind's credentials (it is
# downloaded and kept current), or after putting the file there yourself.
# Empty: no city unless Cloudflare says.
SOLANGE_GEOIP_DB=
SOLANGE_MAXMIND_ACCOUNT_ID=
SOLANGE_MAXMIND_LICENSE_KEY=
