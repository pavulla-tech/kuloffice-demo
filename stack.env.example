# Settings for the local stack (docker-compose.yml). `make up` copies this to
# stack.env on first run; edit stack.env, not this file. Every value here is
# also the default, so a line can be deleted to take it.

# Compose project, and the prefix of the images it builds.
STACK_NAME=kulstack

# Where each service comes from (make up; `make where` shows the result):
#   build     built here from its checkout (the *_DIR settings below)
#   v0.1.0-…  that tag from Docker Hub (developerspavs/kulpay-*), run here
#             (built for amd64: on Apple Silicon it runs emulated, slower)
#   release   the newest v* tag on Docker Hub, run here
#   server    not run here: the deployed one (SERVER_* below)
# For one run: make up WEB=build KULOFFICE=server KEYCLOAK=server, or
# make up PRESET=web (web here, rest on the server) | kuloffice (web and
# kuloffice here, Keycloak on the server) | backend (only kuloffice here) |
# local (everything here).
# The server never calls this laptop: a server kuloffice with a local Keycloak
# is refused, and the deployed web app never uses anything here.
KEYCLOAK=build
KULOFFICE=build
WEB=build
# build or a tag, never server (the server's isn't reachable from outside).
# Only runs with a local kuloffice.
FILESERVER=build
# The token panel runs with a local Keycloak; on also runs it otherwise.
PANEL=

# The deployed stack, for what is set to server.
SERVER_KEYCLOAK_URL=https://auth.kulpay.pavulla.com
SERVER_REALM=kulpay
SERVER_KULOFFICE_URL=https://core.kulpay.pavulla.com
SERVER_WEB_URL=https://app.kulpay.pavulla.com
# A local kuloffice with KEYCLOAK=server: from the server's deploy/.env,
# ADMIN_CLIENT_SECRET (kulpay-backend: the PIN step, the onboarding role) and
# WORKFORCE_API_SECRET (staff sign-in).
SERVER_ADMIN_CLIENT_SECRET=
SERVER_WORKFORCE_API_SECRET=
# ...and, to make your staff account a reviewer of that kuloffice, the server
# Keycloak's admin (KC_ADMIN_USER/KC_ADMIN_PASSWORD there; it is only used to
# look the account up) and the account's email.
SERVER_KC_ADMIN_USER=admin
SERVER_KC_ADMIN_PASSWORD=
SERVER_REVIEWER_EMAIL=
# A kuloffice image from Docker Hub only takes the official license: the
# server's KULOFFICE_LICENSE_KEY. (A local build signs its own: make keys.)
SERVER_LICENSE_KEY=
# The web app here and KEYCLOAK=server: the server's DEV_WEB_ORIGINS must list
# http://localhost:<WEB_PORT> (Actions → Server → provision applies it).

# QR codes for a local kuloffice, through the server's Solange: a key for its
# KulPay app (sl_test_… from Solange's console). Empty: QR codes off. Scan
# webhooks can't reach this laptop.
SOLANGE_URL=https://qr.kulpay.pavulla.com
SOLANGE_API_KEY=

# Sibling checkouts the images are built from. Check out the branch to test in
# each, then `make rebuild S=<service>` (or `make rebuild` for all).
KULOFFICE_DIR=../kuloffice
INTAKA_DIR=../keycloak-phone-authenticator
WEB_DIR=../kulpay-web
FILESERVER_DIR=../boquisso-fileserver

# Host ports. The shared services listen on the same port inside, so changing
# one here moves it everywhere (Keycloak's issuer included).
STACK_BIND=127.0.0.1
KC_PORT=8080
KULOFFICE_PORT=18080
KULOFFICE_GRPC_PORT=50051
WEB_PORT=3000
PANEL_PORT=8765
SMS_INBOX_PORT=8090
FILESERVER_PORT=8082
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DB_PORT=5432

# The issuer built into kuloffice and signed into its license.
LICENSE_ISSUER=pavulla.com

# kuloffice's system admin (HTTP Basic on the /v1/system and license routes).
KULOFFICE_ADMIN_EMAIL=admin@kulpay.local
KULOFFICE_ADMIN_PASSWORD=localadmin

# The demo reviewer, in the staff ("workforce") realm. Sign it in from the
# token panel's Reviewer card. Needs an intaka checkout with
# demo/setup/add_workforce_realm.py.
REVIEWER_EMAIL=reviewer@kulpay.local
REVIEWER_PASSWORD=reviewer
WORKFORCE_API_SECRET=kuloffice-workforce-secret

# false runs KYC without MiniAiLive: every submission goes to a reviewer.
BIOMETRICS_ENABLED=true

# MinIO, local only.
MINIO_ROOT_USER=kulstack
MINIO_ROOT_PASSWORD=kulstack-local
KYC_BUCKET=test
PENDING_BUCKET=kyc-pending
PENDING_EXPIRY_DAYS=1

# Android app origins allowed to use passkeys (see intaka's deploy compose).
PASSKEY_APP_ORIGINS=

# The web app's cookie key. `make up` fills this in with a random value.
KULPAY_SESSION_SECRET=
